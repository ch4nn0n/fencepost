# dependencies (bun install)
node_modules

# output
# dist/ is generated by `bun run build`; the release workflow publishes it to
# the `dist` branch, which is what plugin installs clone. main is source-only.
dist/
out
bin
*.tgz

# generated preset docs pages (built from presets/*.yaml by
# docs/scripts/generate-preset-docs.ts at docs build time)
docs/docs/presets/

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# secrets / keys — never commit (e.g. the release GitHub App private key)
*.pem
*.key
*.p12
*.pfx

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store
