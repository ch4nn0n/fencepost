{
  "name": "fencepost",
  "version": "0.1.1",
  "description": "Configurable permission gate for Claude Code tool calls. Intercepts every tool call and evaluates it against a YAML rule set, allowing, asking, or denying with actionable feedback.",
  "author": {
    "name": "ch4nn0n"
  },
  "homepage": "https://ch4nn0n.github.io/fencepost/",
  "repository": "https://github.com/ch4nn0n/fencepost",
  "license": "GPL-3.0-or-later",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PLUGIN_DIR}}/hooks/pre-tool-use.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PLUGIN_DIR}}/hooks/post-tool-use.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PLUGIN_DIR}}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
